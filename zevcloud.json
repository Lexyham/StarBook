{
  "name": "starbook",
  "type": "nodejs",
  "entry": "server/server.js",
  "nodeVersion": "20",
  "buildCommand": "npm ci --omit=dev",
  "startCommand": "node server/server.js",
  "port": 6543,
  "staticDir": "public",
  "env": {
    "NODE_ENV": "production",
    "PORT": "6543",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true"
  },
  "envSecrets": [
    "MONGODB_URI",
    "JWT_SECRET",
    "BREVO_API_KEY",
    "BREVO_SENDER_EMAIL",
    "BREVO_SENDER_NAME",
    "SITE_URL"
  ],
  "ignore": [
    "node_modules",
    ".git",
    "*.log",
    ".cache"
  ],
  "health": "/api/stats",
  "postDeploy": "node scripts/migrate-json-to-mongodb.js"
}
